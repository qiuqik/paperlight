# Optional standalone parser development stack only. Copy to backend/.env.
# 127.0.0.1 permits access only from the Windows host. Use 0.0.0.0 only
# when an HTTPS reverse proxy or other access control protects the API.
PAPERLIGHT_BIND_HOST=127.0.0.1
PAPERLIGHT_API_PORT=8000

# Comma-separated browser origins, without trailing slash or path.
# The production reader uses its same-origin Next.js proxy.
PAPERLIGHT_CORS_ORIGINS=http://localhost:8040,http://127.0.0.1:8040
