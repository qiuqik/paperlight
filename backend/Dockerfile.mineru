FROM parser_image

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MINERU_HOME=/models \
    MINERU_MODEL_SMALL_BACKEND=onnx \
    MINERU_INTRA_OP_NUM_THREADS=4 \
    MINERU_INTER_OP_NUM_THREADS=1

WORKDIR /app
RUN pip install --no-cache-dir mineru==4.0.10
COPY mineru_worker.py ./mineru_worker.py
EXPOSE 8001
CMD ["uvicorn", "mineru_worker:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
